    "lint:claims": "tsx scripts/lint-claims.ts",
    "fetch:onchain": "tsx scripts/fetch-onchain.ts",
    "pdf": "docusaurus-prince-pdf -u https://docs.idmtoken.com/ --output static/pdf/idm-reborn-whitepaper-v1.0.pdf"
