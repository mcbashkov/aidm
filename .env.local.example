# ============================================================================
# AIDM — contoh environment. Salin ke `.env.local` lalu isi nilainya.
#   cp .env.local.example .env.local
# Nilai NEXT_PUBLIC_* aman di klien. Yang lain HANYA server (jangan commit).
# ============================================================================

# ── Privy (auth email/HP/Google + embedded wallet otomatis) ─────────────────
# Buat aplikasi di https://dashboard.privy.io lalu salin App ID.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# Untuk verifikasi token Privy di server (API routes). Rahasia.
PRIVY_APP_SECRET=your-privy-app-secret
# Kunci untuk menandatangani cookie sesi (HMAC). Default: pakai PRIVY_APP_SECRET.
SESSION_SECRET=ganti-dengan-string-acak-panjang

# ── Supabase (Postgres + pgvector + Storage) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Service role — HANYA server, akses penuh, lewati RLS. Rahasia.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── opBNB (jaringan default — §9.1 / §16 #9) ────────────────────────────────
# opbnb = mainnet (chainId 204) · opbnb-testnet = testnet (chainId 5611)
NEXT_PUBLIC_DEFAULT_CHAIN=opbnb
NEXT_PUBLIC_OPBNB_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
NEXT_PUBLIC_OPBNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org

# ── AI: agen riset (Claude API) — §9.1 ──────────────────────────────────────
# Wajib untuk mengaktifkan agen riset (M1). Ambil di console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model (opsional — default sudah sesuai PRD §9.1)
AIDM_AGENT_MODEL=claude-sonnet-5
AIDM_LIGHT_MODEL=claude-haiku-4-5
# Embedding untuk cache korpus (opsional; tanpa ini cache vektor dinonaktifkan).
# OpenAI text-embedding-3-small = 1536 dim (sesuai skema §10).
OPENAI_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
