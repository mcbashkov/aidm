# ============================================================================
# AIDM — contoh environment. Salin ke `.env.local` lalu isi nilainya.
#   cp .env.local.example .env.local
# Nilai NEXT_PUBLIC_* aman di klien. Yang lain HANYA server (jangan commit).
#
# ATURAN "STRING TIDAK KOSONG" — berlaku untuk SELURUH berkas ini.
# Deteksi konfigurasi memakai "string tidak kosong", bukan "variabel ada".
# Biarkan nilai KOSONG untuk fitur yang belum siap — placeholder seperti
# `your-privy-app-id` akan dianggap terisi dan membuat aplikasi mencoba boot
# Privy dengan kunci palsu. Kosong = mode placeholder (aplikasi tetap jalan,
# fitur terkait non-aktif dan menjawab 501 dengan jujur).
#
# KONSEKUENSI UNTUK KODE — jangan pernah membaca cadangan env dengan `??`:
#
#     process.env.A ?? process.env.B      // SALAH: "" bukan nullish
#     envPertama("A", "B")                // BENAR: nilai pertama yang tidak kosong
#
# `??` hanya jatuh pada `undefined`, sedangkan berkas ini justru MENGANJURKAN
# variabel yang ada tapi kosong. Akibatnya cadangan tidak pernah terpakai, dan
# kegagalannya diam. Dua kali sudah terjadi di proyek ini:
#   · MISSION_RELAYER_PRIVATE_KEY kosong → klaim misi menjawab 501 padahal
#     SEAL_RELAYER_PRIVATE_KEY terisi;
#   · AIDM_REWARD_CHAIN kosong → chain jatuh ke DEFAULT (mainnet!) alih-alih
#     ke AIDM_SEAL_CHAIN — kelas bug yang paling mahal di berkas ini.
# Helper-nya: `lib/env.ts`.
# ============================================================================

# ── Privy (auth email/HP/Google + embedded wallet otomatis) ─────────────────
# Buat aplikasi di https://dashboard.privy.io lalu salin App ID.
NEXT_PUBLIC_PRIVY_APP_ID=
# Untuk verifikasi token Privy di server (API routes). Rahasia.
PRIVY_APP_SECRET=
# Metode login yang diminta ke Privy — HARUS sama dengan yang diaktifkan di
# dashboard Privy. Meminta metode yang belum aktif membuat Privy melempar
# ("Login with Google not allowed"). Kosong = default `email,sms,google`.
NEXT_PUBLIC_PRIVY_LOGIN_METHODS=
# Kunci untuk menandatangani cookie sesi (HMAC). Default: pakai PRIVY_APP_SECRET.
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# ── Supabase (Postgres + pgvector + Storage) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — HANYA server, akses penuh, lewati RLS. Rahasia.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres, dipakai `pnpm db:migrate` (bukan runtime app).
# Project Settings → Database → Connection string → URI. Rahasia.
SUPABASE_DB_URL=

# ── opBNB (jaringan default — §9.1 / §16 #9) ────────────────────────────────
# opbnb = mainnet (chainId 204) · opbnb-testnet = testnet (chainId 5611)
NEXT_PUBLIC_DEFAULT_CHAIN=opbnb
NEXT_PUBLIC_OPBNB_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
NEXT_PUBLIC_OPBNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
# ── Segel on-chain (§7.5 / §9.4 — M4) ───────────────────────────────────────
# Deploy: pnpm deploy:attestation (testnet) — skrip mencetak nilai di bawah.
# Selama SALAH SATU kosong, POST /api/laporan/segel jujur menjawab 501 dan
# tombol Segel di UI nonaktif dengan keterangan (segelSiap=false).
NEXT_PUBLIC_REPORT_ATTESTATION_ADDRESS=
# Chain kontrak segel: opbnb-testnet (fase M4) | opbnb. Kosong = ikut
# NEXT_PUBLIC_DEFAULT_CHAIN. Dipisah karena app bisa mainnet sementara segel
# masih testnet.
AIDM_SEAL_CHAIN=
# Kunci privat relayer treasury (sponsor gas segel, §7.5). RAHASIA — hanya
# dibaca server (lib/laporan/segel-server.ts), jangan pernah berawalan
# NEXT_PUBLIC_. Untuk deploy kontrak: DEPLOYER_PRIVATE_KEY (boleh kunci yang
# sama), opsional SEAL_RELAYER_ADDRESS bila relayer ≠ deployer.
SEAL_RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# ── Reward misi on-chain (§7.6 / §8.1 — M4) ─────────────────────────────────
# Deploy: pnpm deploy:rewards (testnet) — skrip men-deploy IDMX +
# MissionRewards, mendanai kontrak reward, lalu mencetak nilai di bawah.
# Selama SALAH SATU kosong, tombol Klaim nonaktif dengan keterangan dan
# POST /api/missions/klaim menjawab 501 — progres misi tetap tampil apa adanya.
NEXT_PUBLIC_IDMX_ADDRESS=
NEXT_PUBLIC_MISSION_REWARDS_ADDRESS=
# Chain kontrak reward. Kosong = ikut AIDM_SEAL_CHAIN, lalu NEXT_PUBLIC_DEFAULT_CHAIN.
AIDM_REWARD_CHAIN=
# Kunci penandatangan voucher (EIP-712). RAHASIA — setara "mesin cetak IDMX
# dalam batas cap". Cap harian & anti-replay tetap ditegakkan kontrak, jadi
# kebocoran kunci ini terbatas oleh aturan on-chain, bukan tak terbatas.
# Opsional saat deploy:rewards: isi bila penandatangan ≠ deployer.
MISSION_VOUCHER_ADDRESS=
MISSION_VOUCHER_PRIVATE_KEY=
# Pembayar gas klaim (gasless bagi user). Kosong = pakai SEAL_RELAYER_PRIVATE_KEY.
MISSION_RELAYER_PRIVATE_KEY=

# ── AI: agen riset (Claude API) — §9.1 ──────────────────────────────────────
# Wajib untuk mengaktifkan agen riset (M1). Ambil di console.anthropic.com
ANTHROPIC_API_KEY=
# Model (opsional — default sudah sesuai PRD §9.1)
AIDM_AGENT_MODEL=claude-sonnet-5
AIDM_LIGHT_MODEL=claude-haiku-4-5
# Batas token output per panggilan agen (opsional, default 8192). Pada Sonnet 5
# adaptive thinking aktif default dan angka ini membatasi thinking + jawaban
# sekaligus — jangan turunkan di bawah ~6000 atau sintesis JSON bisa terpotong.
AIDM_AGENT_MAX_TOKENS=

# ── Embedding: Gemini (§9.1) — HANYA untuk cache vektor, bukan otak agen ───
# Gemini text-embedding-004 = 768 dim (sesuai kolom vector(768) di §10).
# WAJIB bila ingin AC §7.2 "query serupa kedua dalam 7 hari dijawab dari cache"
# lulus — tanpa ini checkCache() selalu kosong dan setiap query jadi riset
# segar (tarif penuh). Ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ambang kemiripan cosine agar query dianggap "serupa" oleh cache (opsional,
# default 0.85). Turunkan = lebih sering kena cache tapi risiko jawaban meleset.
AIDM_CACHE_MIN_SIMILARITY=

# ── Payment gateway: Midtrans (§16 #3 — diputuskan 2026-08-08) ──────────────
# Dipakai mulai M3 (pembelian kredit QRIS/VA). Sandbox dulu, baru production.
# Dashboard → Settings → Access Keys.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Rahasia. Juga dipakai memverifikasi signature webhook settlement (§7.5).
MIDTRANS_SERVER_KEY=
# false = sandbox (default saat kosong), true = production
MIDTRANS_IS_PRODUCTION=

# ── App (domain produk: ai.idmtoken.com — §16 #2, diputuskan 2026-08-14) ────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IDM Reborn + Swap (BSC + opBNB) — batch sisi token (§10) ────────────────
# Ikuti pola "string tidak kosong": biarkan field BENAR-BENAR KOSONG sampai
# kontraknya nyata — fitur swap jujur menjawab 501 dan tombolnya nonaktif.
#
# URUTAN DEPLOY & SIAPA MENGISI APA (🧑 = Anda isi manual · 🖨 = dicetak skrip):
#   0. 🧑 Isi: IDM_LEGACY_DEPLOYER_PRIVATE_KEY, IDM_TREASURY_ADDRESS,
#      IDM_TREASURY_PRIVATE_KEY, SWAP_SIGNER_PRIVATE_KEY.
#      Isi gas: tBNB opBNB-testnet → deployer biasa; tBNB BSC-testnet →
#      wallet lama + deployer biasa + treasury.
#   1. pnpm deploy:rewards      → 🖨 blok "Reward misi" di atas (IDMX dkk)
#   2. pnpm deploy:idm-bsc      → 🖨 NEXT_PUBLIC_IDM_REBORN_ADDRESS
#      (setelah sukses: IDM_LEGACY_DEPLOYER_PRIVATE_KEY boleh DIHAPUS)
#   3. pnpm deploy:swap-bsc     → 🖨 NEXT_PUBLIC_SWAP_CLAIM_ADDRESS
#   4. pnpm fund:swap-pool      — treasury kirim 150 juta IDM ke SwapClaim
#      (setelah sukses: IDM_TREASURY_PRIVATE_KEY boleh DIHAPUS)
#   5. pnpm deploy:swap-opbnb   → 🖨 NEXT_PUBLIC_SWAP_INITIATOR_ADDRESS
#   6. 🧑 SWAP_RELAYER_CURSOR_BLOCK = nomor blok opBNB saat langkah 5 selesai
#   Salin semua nilai 🖨 juga ke Environment Variables Vercel → redeploy.
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Kosong = dipetakan dari AIDM_REWARD_CHAIN (opbnb-testnet→bsc-testnet, opbnb→bsc)
AIDM_SWAP_CHAIN=

# [langkah 0] Deployer KHUSUS IDMReborn = wallet lama IDM (provenance ATH;
# tampil sebagai Contract Creator di BscScan). 1 tx saja; bukan owner, bukan
# treasury. RAHASIA — jangan commit; hapus setelah langkah 2.
IDM_LEGACY_DEPLOYER_PRIVATE_KEY=

# [langkah 0] Treasury penerima 1 miliar IDM. Testnet: EOA baru biasa.
# Mainnet: WAJIB multisig. Alamat WAJIB benar sebelum langkah 2 —
# salah alamat = suplai nyangkut permanen (IDMReborn tanpa fungsi owner).
IDM_TREASURY_ADDRESS=
# RAHASIA; hanya untuk langkah 4 (1 tx, testnet saja). Hapus setelah terpakai.
# Mainnet: transfer dari UI multisig — kunci treasury TIDAK pernah ke sini.
IDM_TREASURY_PRIVATE_KEY=

# [langkah 0] Penandatangan voucher swap (relayer opBNB→BSC). RAHASIA.
# WAJIB kunci BARU (buat: openssl rand -hex 32) — skrip deploy menolak bila
# alamat turunannya sama dengan MISSION_VOUCHER_PRIVATE_KEY.
SWAP_SIGNER_PRIVATE_KEY=

# [langkah 2 / 3 / 5] Alamat kontrak — dicetak skrip, tinggal salin.
NEXT_PUBLIC_IDM_REBORN_ADDRESS=
NEXT_PUBLIC_SWAP_CLAIM_ADDRESS=
NEXT_PUBLIC_SWAP_INITIATOR_ADDRESS=

# [langkah 6] Nilai BOOTSTRAP kursor relayer (nomor blok opBNB saat
# SwapInitiator ter-deploy); setelahnya cursor berjalan di DB.
SWAP_RELAYER_CURSOR_BLOCK=

# [langkah 6] Pelindung endpoint relayer /api/relayer/tick — hanya pemanggil
# dengan secret ini yang bisa memicu tick (Vercel Cron / penjadwal luar).
# Buat: openssl rand -base64 32
CRON_SECRET=

# [MAINNET SAJA — biarkan terkomentar; testnet pakai default teruji 100k/200k]
# Dihitung via runbook ratchet §5 SEBELUM deploy:swap-opbnb --mainnet
# (satuan IDMX utuh, tanpa e18):
#   SWAP_GLOBAL_THRESHOLD_IDMX = 3× proyeksi permintaan mingguan normal
#   SWAP_LIFETIME_CAP_IDMX     = kolam IDM di SwapClaim × rate saat itu
#SWAP_GLOBAL_THRESHOLD_IDMX=
#SWAP_LIFETIME_CAP_IDMX=

